#!/usr/bin/env bash
set -euo pipefail

report="$(hermeskey --status)"

if command -v kdialog >/dev/null 2>&1; then
  kdialog --title "HermesKey Status" --msgbox "$report"
  exit 0
fi

if command -v zenity >/dev/null 2>&1; then
  zenity --info --title="HermesKey Status" --width=520 --text="$report"
  exit 0
fi

printf '%s\n' "$report"
