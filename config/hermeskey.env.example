# HermesKey configuration
# Copy or edit this file at ~/.config/hermeskey/hermeskey.env

# faster-whisper model name
MODEL=medium

# Spoken language. Set to empty for auto-detect.
STT_LANG=en

# Your microphone source. Discover with: pactl list short sources
RECORD_SOURCE=alsa_input.usb-Beyerdynamic_FOX_5.00-00.mono-fallback

# Clipboard command for Wayland
CLIP_CMD=wl-copy

# type | clipboard
INSERT_MODE=type
COPY_TO_CLIPBOARD=1

# auto | ydotool | wtype | xdotool
TYPE_BACKEND=auto

# UI
OVERLAY_ENABLED=1
SOUND_ENABLED=1
FOCUS_SAFE_MODE=0

# Soft tones
START_TONE_HZ=660
STOP_TONE_HZ=520
TONE_DURATION=0.035
TONE_VOLUME=0.20

# App-specific paste fallback
TERMINAL_APPS=org.wezfurlong.wezterm,org.kde.konsole,kitty,Alacritty,ghostty,foot,gnome-terminal,tilix,xfce4-terminal
PASTE_FOR_APPS=$TERMINAL_APPS
PASTE_SHORTCUT=auto
