[Unit]
Description=HermesKey prewarmed faster-whisper server

[Service]
Type=simple
ExecStart=%h/venvs/stt/bin/python %h/.local/bin/ptt_stt_server.py --socket /tmp/ptt_stt.sock --model medium --lang en
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
